[Unit]
Description=Remove expired EA-PDF web results

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/eapdf
Environment=PATH=/opt/eapdf/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/opt/eapdf/.venv/bin/python -B -c "import validator_web; validator_web.cleanup_expired_jobs()"
