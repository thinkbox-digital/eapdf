+          if (raw === undefined || !step(collection.locator, depth)) return;
+          const loc = locator(raw, path),
+            obj = fetch(raw),
+            key = raw instanceof Ref ? loc.path : obj;
+          if (seenFolders.has(key)) {
+            report("FOLDER_CYCLE", loc);
+            return;
+          }
