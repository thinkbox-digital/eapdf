+            }
+          }
+          files.set(loc.path, {
+            locator: loc,
+            filename: scalar(spec.get("F")),
+            unicodeFilename: scalar(spec.get("UF")),
+            relationship: scalar(spec.get("AFRelationship")),
+            description: scalar(spec.get("Desc")),
+            embedding:
+              ef === undefined
+                ? "missing"
+                : ef instanceof Dict && streams.size
+                  ? "present"
+                  : "invalid",
+            streams: [...streams.values()],
+            origins: [],
+          });
