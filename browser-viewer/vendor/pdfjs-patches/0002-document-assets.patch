+          ? obj.entries()
+          : dict.getRawEntries();
+        for (const [key_, child] of children) {
+          if (pending.length + visits >= limits.maxObjects) {
+            report("OBJECT_LIMIT", loc);
+            break;
+          }
+          if (
+            child instanceof Ref ||
+            child instanceof Dict ||
+            child instanceof BaseStream ||
+            Array.isArray(child)
