+  read({ documentId, fileId, streamId, maxBytes }) {
+    if (documentId !== this.catalog.pdfManager.docId)
+      throw new Error("Foreign document locator");
+    if (
+      !Number.isSafeInteger(maxBytes) ||
+      maxBytes < 0 ||
+      maxBytes > 536870912 // Per-request cap; inspection defaults stay unchanged.
+    )
