+import { BaseStream } from "./base_stream.js";
+import { DecodeStream } from "./decode_stream.js";
+import { MissingDataException } from "./core_utils.js";
+import { stringToPDFString } from "./string_utils.js";
+
+const CEILINGS = Object.freeze({
+  maxObjects: 100000,
+  maxDepth: 64,
+  maxFiles: 2048,
+  maxMetadataBytes: 16777216,
+  maxStreamBytes: 16777216,
+});
+const locator = (raw, path) => ({
+  ref: raw instanceof Ref ? { num: raw.num, gen: raw.gen } : null,
+  path: raw instanceof Ref ? `object:${raw.num}:${raw.gen}` : path,
+});
+const hex = value =>
+  Array.from(value, c => c.charCodeAt(0).toString(16).padStart(2, "0")).join(
+    ""
+  );
+const failedDecoders = new WeakSet();
+function scalar(value) {
+  if (value === undefined) return { kind: "missing" };
+  if (value === null) return { kind: "null" };
+  if (typeof value === "string" || value instanceof Name) {
+    const raw = typeof value === "string" ? value : value.name;
+    if (raw.length > 65536) return { kind: "unavailable" };
+    return {
+      kind: typeof value === "string" ? "string" : "name",
+      value: typeof value === "string" ? stringToPDFString(raw, true) : raw,
+      bytesHex: hex(raw),
+    };
+  }
+  if (
+    typeof value === "boolean" ||
+    (typeof value === "number" && Number.isFinite(value))
+  )
+    return { kind: typeof value, value };
+  return { kind: "unsupported" };
+}
+
+function boundedBytes(stream, maximum) {
+  if (!(stream instanceof BaseStream))
+    throw new Error("Not an embedded stream");
+  if (failedDecoders.has(stream))
+    throw new Error("Previous decode failed; reopen the document to retry");
+  const filter = stream.dict?.get("Filter");
+  const filters = Array.isArray(filter) ? filter : filter ? [filter] : [];
+  const allowed = new Set([
+    "FlateDecode",
+    "Fl",
+    "LZWDecode",
+    "LZW",
+    "ASCII85Decode",
+    "A85",
+    "ASCIIHexDecode",
+    "AHx",
+    "RunLengthDecode",
+    "RL",
+    "Crypt",
+  ]);
+  if (
+    filters.length > 8 ||
+    filters.some(f => !(f instanceof Name) || !allowed.has(f.name))
+  ) {
+    throw new Error("Unsupported extraction filter");
+  }
+  if (stream.dict?.xref?.encrypt?.encryptionKey === null)
+    throw new Error("Embedded stream requires a password");
+  const limits = [],
+    seen = new Set();
+  let current = stream;
+  while (current instanceof BaseStream && !seen.has(current)) {
+    if (seen.size >= 16) throw new Error("Decode chain limit");
+    seen.add(current);
+    if (current instanceof DecodeStream) {
+      limits.push([current, current.maxBufferLength]);
+      current.maxBufferLength = Math.min(current.maxBufferLength, maximum + 1);
+    }
+    current = current.str || current.stream;
+  }
+  const position = stream.pos;
+  try {
+    stream.reset();
+    const chunks = [];
+    let count = 0;
+    while (true) {
+      const chunk = stream.getBytes(Math.min(65536, maximum + 1 - count));
+      count += chunk.length;
+      if (count > maximum)
+        throw new Error("Decoded stream byte limit exceeded");
+      if (!chunk.length) break;
+      chunks.push(chunk);
+    }
+    const bytes = new Uint8Array(count);
+    let offset = 0;
+    for (const chunk of chunks) {
+      bytes.set(chunk, offset);
+      offset += chunk.length;
+    }
+    return bytes;
+  } catch (error) {
+    if (!(error instanceof MissingDataException)) failedDecoders.add(stream);
+    throw error;
+  } finally {
+    stream.pos = position;
+    for (const [decoder, old] of limits) decoder.maxBufferLength = old;
+  }
