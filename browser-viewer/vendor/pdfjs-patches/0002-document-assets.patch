+      raw instanceof Ref ? this.catalog.xref.fetch(raw) : raw;
+    const report = (code, loc, error) => {
+      if (error instanceof MissingDataException) throw error;
+      diagnostics.push({ code, locator: loc });
+    };
+    let visits = 0;
+    const step = (loc, depth) => {
+      if (++visits > limits.maxObjects || depth > limits.maxDepth) {
+        report("OBJECT_LIMIT", loc);
+        return false;
+      }
