@@ -0,0 +1,21 @@
+/* Copyright 2026 Thinkbox Digital
+ * Licensed under the Apache License, Version 2.0.
+ */
+
+// Yield a task, not a microtask, so worker messages can run during inspection.
+// Unlike nested setTimeout(0), MessageChannel avoids the browser's timer clamp.
+// Each yield owns its ports; closing them before resolving leaves no idle port
+// keeping a document worker (or a source-test process) alive.
+function yieldInspection() {
+  return new Promise(resolve => {
+    const { port1, port2 } = new MessageChannel();
+    port1.onmessage = () => {
+      port1.close();
+      port2.close();
+      resolve();
+    };
+    port2.postMessage(null);
+  });
+}
+
+export { yieldInspection };
