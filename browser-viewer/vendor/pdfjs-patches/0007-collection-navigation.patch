+/* Copyright 2026 PDF.js contributors
+ * Licensed under the Apache License, Version 2.0.
+ * http://www.apache.org/licenses/LICENSE-2.0
+ */
+import { Dict, Name } from "./primitives.js";
+import { stringToPDFString } from "./string_utils.js";
+import { PDFImage } from "./image.js";
+import { PDFFunctionFactory } from "./function.js";
+import { GlobalColorSpaceCache, LocalColorSpaceCache } from "./image_utils.js";
+import { MissingDataException } from "./core_utils.js";
+import { BaseStream } from "./base_stream.js";
+
+// Preserve byte-string identity for name-tree lookups. Never execute actions or
+// follow external file specifications while inspecting a link.
+export function embeddedAction(action) {
+  const result = { steps: [], destination: null, error: null };
+  try {
+    if (action.has("F")) throw new Error("This link requires an external PDF. Open that file separately.");
+    let dest = action.get("D");
+    if (dest instanceof Name) dest = dest.name;
+    if (typeof dest === "string" && dest.length <= 65536) result.destination = stringToPDFString(dest, true);
+    else if (Array.isArray(dest) && dest.length >= 2 && dest.length <= 6 && Number.isInteger(dest[0]) && dest[0] >= 0 && dest[1] instanceof Name && dest.slice(2).every(v => v === null || (typeof v === "number" && Number.isFinite(v)))) result.destination = [dest[0], { name: dest[1].name }, ...dest.slice(2)];
+    else throw new Error("Embedded link destination is invalid.");
+    let target = action.get("T");
+    const seen = new Set();
+    do {
+      if (!(target instanceof Dict)) throw new Error("Embedded link target is invalid.");
+      if (seen.has(target) || seen.size >= 32) throw new Error("Embedded link target is cyclic or too deep.");
+      seen.add(target);
+      const r = target.get("R");
+      if (!(r instanceof Name) || !["C", "P"].includes(r.name)) throw new Error("Embedded link relationship is invalid.");
+      const step = { relationship: r.name };
+      if (r.name === "C") {
+        const name = target.get("N");
+        if (typeof name === "string" && name.length <= 65536) step.nameHex = Array.from(name, c => c.charCodeAt(0).toString(16).padStart(2,"0")).join("");
+        else {
+          const page = target.get("P"), annotation = target.get("A");
+          const valid = v => (Number.isInteger(v) && v >= 0) || (typeof v === "string" && v.length <= 65536);
+          if (!valid(page) || !valid(annotation)) throw new Error("Embedded attachment target is invalid.");
+          step.page = typeof page === "string" ? stringToPDFString(page, true) : page;
+          step.annotation = typeof annotation === "string" ? stringToPDFString(annotation, true) : annotation;
+        }
+      }
+      result.steps.push(step);
+      target = target.get("T");
+    } while (target !== undefined);
+  } catch (error) { if (error instanceof MissingDataException) throw error; result.error = String(error.message || error); }
+  return result;
+}
+
+export async function folderThumbnail(image, xref) {
+  if (!(image instanceof BaseStream)) throw new Error("Folder thumbnail is unavailable.");
+  // Check image and mask dimensions before any codec allocation. Keep this
+  // deliberately below the page renderer's limits for background work.
+  const pending = [image], seen = new Set(); let pixels = 0;
+  while (pending.length) {
+    const stream = pending.pop();
+    if (seen.has(stream) || seen.size >= 4) throw new Error("Invalid thumbnail mask hierarchy.");
+    seen.add(stream);
+    const d = stream.dict, w = d.get("Width", "W"), h = d.get("Height", "H"), length = d.get("Length");
+    if (!Number.isInteger(w) || !Number.isInteger(h) || w < 1 || h < 1 || w > 2048 || h > 2048 || (pixels += w*h) > 1048576 || !Number.isInteger(length) || length < 0 || length > 4194304) throw new Error("Folder thumbnail exceeds the preview budget.");
+    for (const key of ["SMask", "Mask"]) { const mask = d.get(key); if (mask instanceof BaseStream) pending.push(mask); }
+  }
+  const decoded = await PDFImage.buildImage({ xref, res: Dict.empty, image, pdfFunctionFactory: new PDFFunctionFactory({xref}), globalColorSpaceCache: new GlobalColorSpaceCache(), localColorSpaceCache: new LocalColorSpaceCache() });
+  if (decoded.width * decoded.height > 1048576) throw new Error("Folder thumbnail exceeds the preview budget.");
+  return decoded.createImageData(true, false);
+}
