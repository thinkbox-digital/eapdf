+  const ref = obj =>
+    obj instanceof Ref ? { num: obj.num, gen: obj.gen } : null;
+  const locator = (obj, path) => ({
+    ref: ref(obj),
+    path: obj instanceof Ref ? `object:${obj.num}:${obj.gen}` : path,
+  });
