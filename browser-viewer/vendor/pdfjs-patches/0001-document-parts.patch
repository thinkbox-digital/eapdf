+    let obj;
+    try {
+      obj = fetch(raw);
+    } catch (error) {
+      fail(error, loc);
+      return { kind: "invalid", ref: reference };
+    }
+    if (obj === undefined) {
+      return { kind: "missing", ref: reference };
+    }
+    if (obj === null) {
+      return { kind: reference ? "invalid" : "null", ref: reference };
