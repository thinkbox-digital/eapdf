+        dict.getRaw("DPartRootNode"),
+        null,
+        `${rootLoc.path}/DPartRootNode`,
+        0,
+        rootLoc
+      );
+    }
+  } catch (error) {
+    fail(error, rootLoc);
+    result.status = "invalid";
+  }
+  return result;
+}
