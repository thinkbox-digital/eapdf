{
  "name": "eapdf-browser-viewer",
  "version": "1.2.0-beta.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "check": "python3 ../scripts/check_public_docs.py && tsc --noEmit && node scripts/inspection-contract.mjs --check",
    "test:m1": "node --test tests/inspection-contract.test.mjs && python3 -B -m unittest discover -s reference -p 'test_*.py' -v",
    "fixtures:check": "python3 -B reference/fixtures.py",
    "build": "node scripts/build.mjs",
    "build:pdfjs": "node scripts/rebuild-pdfjs.mjs",
    "verify:pdfjs": "node scripts/pdfjs-patch.mjs",
    "test:m2": "npm run build && node --test tests/document-parts.test.mjs && npm run test:parts",
    "test:parts": "node scripts/document-parts-smoke.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:browser && npm run test:parts && npm run test:ui && npm run test:reading && npm run test:downloads && npm run test:retry && npm run test:loading && npm run test:associations && npm run test:inspection-warning && npm run test:supplements && npm run test:export && npm run test:allocation && npm run test:navigation && npm run test:collection-matches && npm run test:design && npm run test:progressive && npm run test:responsive && npm run test:redesign && npm run test:pdfjs-compat && npm run test:metadata-index && npm run test:fulltext-index && npm run test:reader-polish && npm run test:viewer-improvements && npm run test:loading-filter-keyboard && npm run test:attachment-window && npm run test:portfolio && npm run test:attachment-owners && npm run test:file-drop && npm run test:folder-aliases && npm run test:message-download && npm run test:metadata-export && npm run test:collection-start && npm run test:portfolio-opening && node scripts/thread-preview-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:firefox": "node scripts/firefox-smoke.mjs && node scripts/file-drop-firefox-smoke.mjs",
    "verify:licenses": "node scripts/licenses.mjs",
    "test:assets": "node scripts/assets-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:semantics": "node scripts/semantic-smoke.mjs",
    "test:beta": "node scripts/beta-smoke.mjs",
    "package:beta": "npm run build && python3 scripts/package-beta.py",
    "test:downloads": "node scripts/download-smoke.mjs",
    "test:supplements": "node scripts/supplement-smoke.mjs",
    "test:inspection-warning": "node scripts/inspection-warning-smoke.mjs",
    "test:loading": "node scripts/loading-smoke.mjs",
    "test:associations": "node scripts/association-smoke.mjs && node scripts/file-description-expansion-smoke.mjs",
    "test:retry": "node scripts/retry-smoke.mjs",
    "test:reading": "node scripts/reading-improvements-smoke.mjs && node scripts/bookmark-navigation-stability-smoke.mjs && node scripts/opening-zoom-default-smoke.mjs",
    "test:export": "node scripts/export-smoke.mjs",
    "test:allocation": "node scripts/allocation-recovery-smoke.mjs",
    "test:navigation": "node scripts/navigation-refresh-smoke.mjs",
    "test:collection-matches": "node scripts/collection-match-smoke.mjs",
    "test:design": "node scripts/viewer-design-smoke.mjs",
    "test:progressive": "node scripts/progressive-loading-smoke.mjs",
    "test:responsive": "node scripts/responsive-smoke.mjs",
    "test:redesign": "node scripts/redesign-smoke.mjs",
    "test:pdfjs-compat": "node scripts/pdfjs-compat-smoke.mjs",
    "test:archive-memory": "node scripts/archive-memory-smoke.mjs",
    "test:metadata-index": "node scripts/metadata-index-smoke.mjs && node scripts/metadata-addresses-smoke.mjs",
    "benchmark:metadata-index": "node scripts/metadata-index-benchmark.mjs",
    "test:fulltext-index": "node scripts/fulltext-index-smoke.mjs",
    "benchmark:fulltext-index": "node scripts/fulltext-index-benchmark.mjs",
    "test:viewer-improvements": "node scripts/viewer-improvements-smoke.mjs",
    "test:reader-polish": "node scripts/reader-polish-smoke.mjs",
    "test:loading-filter-keyboard": "node scripts/loading-filter-keyboard-smoke.mjs",
    "test:attachment-window": "node scripts/attachment-window-smoke.mjs",
    "test:portfolio": "node scripts/portfolio-smoke.mjs && node scripts/portfolio-download-parent-smoke.mjs",
    "test:attachment-owners": "node scripts/attachment-owner-smoke.mjs",
    "test:file-drop": "node scripts/file-drop-smoke.mjs",
    "test:file-drop:firefox": "node scripts/file-drop-firefox-smoke.mjs",
    "test:folder-aliases": "node scripts/folder-alias-smoke.mjs",
    "test:message-download": "node scripts/message-download-smoke.mjs",
    "test:metadata-export": "node scripts/metadata-export-smoke.mjs",
    "test:collection-start": "node scripts/collection-start-smoke.mjs",
    "test:section8": "npm run check && npm run build && node scripts/section8-acceptance.mjs",
    "test:portfolio-opening": "node scripts/portfolio-opening-smoke.mjs",
    "test:thread-preview": "npm run check && npm run build && node --test tests/thread-graph.test.mjs && node scripts/thread-preview-smoke.mjs",
    "build:lite": "node lite/run.mjs",
    "export:lite": "node lite/export.mjs",
    "build:lite:pdfjs": "node lite/rebuild-hooks.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
