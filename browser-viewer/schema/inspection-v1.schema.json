                }
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "state",
            "value",
            "basis",
            "raw",
            "evidence",
            "reason",
            "candidates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "missing",
                "invalid",
                "ambiguous",
                "unsupported",
                "unavailable",
                "not-evaluated"
              ]
            },
            "value": {
              "type": "null"
            },
            "basis": {
              "const": "none"
            },
            "raw": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RawValue"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectLocator"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "state",
            "value",
            "basis",
            "raw",
            "evidence",
            "reason",
            "candidates"
          ],
          "additionalProperties": false
        }
      ]
    },
    "NumberObservation": {
