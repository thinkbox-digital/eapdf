{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thinkbox:eapdf:inspection:1",
  "title": "EA-PDF read-only inspection v1",
  "description": "Extraction observations, not validation verdicts. See docs/inspection-schema.md.",
  "$ref": "#/$defs/InspectionResult",
  "$defs": {
    "InspectionState": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "ambiguous",
        "unsupported",
        "unavailable",
        "not-evaluated"
      ]
    },
    "ObjectLocator": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        },
        "objectNumber": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "documentId",
        "objectNumber",
        "generation",
        "path"
      ],
      "additionalProperties": false
    },
    "RawValue": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "pdf-string",
            "pdf-name",
            "pdf-integer",
            "pdf-boolean",
            "pdf-real",
            "pdf-array",
            "pdf-dictionary",
            "pdf-stream",
            "pdf-null",
            "xmp-text",
            "xmp-attribute",
            "xmp-structure",
            "header"
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytesHex": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "text",
        "bytesHex"
      ],
      "additionalProperties": false
    },
    "TextObservation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "present"
            },
            "value": {
              "type": "string"
            },
            "basis": {
              "enum": [
                "observed",
                "derived",
                "inferred"
              ]
            },
            "raw": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RawValue"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectLocator"
              }
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "state",
            "value",
            "basis",
            "raw",
            "evidence",
            "reason",
            "candidates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "missing",
                "invalid",
                "ambiguous",
                "unsupported",
                "unavailable",
                "not-evaluated"
              ]
            },
            "value": {
              "type": "null"
            },
            "basis": {
              "const": "none"
            },
            "raw": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RawValue"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectLocator"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "state",
            "value",
            "basis",
            "raw",
            "evidence",
            "reason",
            "candidates"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DeclaredProfile": {
      "enum": [
        "s",
        "si",
        "m",
        "mi",
        "c",
        "ci"
      ]
    },
    "ProfileObservation": {
