+    /**
+     * The upstream field readers catch Exception and can convert it into empty metadata.
+     * A processing limit must unwind the whole PST conversion so no partial source is published.
+     */
+    public static final class ProcessingLimitExceeded extends Error {
+        private static final long serialVersionUID = 1L;
+
+        ProcessingLimitExceeded(String message) {
+            super(message);
+        }
+    }
+
+    private static long nodeLimit() {
+        long heapBound = Math.max(1024L, Runtime.getRuntime().maxMemory() / 16);
+        String value = System.getProperty("eapdf.maxMessageBytes", System.getenv("EAPDF_MAX_MESSAGE_BYTES"));
+        long configured = value == null || value.trim().isEmpty() ? heapBound : Long.parseLong(value);
+        if (configured <= 0) {
+            throw new ProcessingLimitExceeded("EAPDF_MAX_MESSAGE_BYTES must be a positive integer");
+        }
+        return Math.min(Math.min(heapBound, configured), Integer.MAX_VALUE - 8L);
+    }
+
+    private static void checkSize(long size, long limit) {
+        if (Thread.currentThread().isInterrupted()) {
+            throw new ProcessingLimitExceeded("PST decoding was cancelled");
+        }
+        if (size < 0 || size > limit) {
+            throw new ProcessingLimitExceeded("PST node exceeds the " + limit + "-byte processing limit");
+        }
+    }
 
