{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eapdf-rewrite:normalized-message:1",
  "title": "Proposed normalized message interchange contract",
  "description": "Replacement design boundary, not an existing generator input. Hashes, path confinement, MIME/byte semantics, date truth and ownership require semantic validation beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mailGuid", "source", "headers", "sent", "selectedBody", "memberships", "attachments", "warnings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mailGuid": {"type": "string", "minLength": 1},
    "messageId": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "representation", "originalFilename", "mediaType", "payload"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["eml", "msg", "pst", "mbox", "gmail"]},
        "representation": {"enum": ["original", "exported", "reconstructed"]},
        "parentSourceId": {"type": "string", "minLength": 1},
        "originalFilename": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 1},
        "payload": {"$ref": "#/$defs/payload"}
      },
      "allOf": [{"if": {"properties": {"representation": {"enum": ["exported", "reconstructed"]}}}, "then": {"required": ["parentSourceId"]}}]
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "raw", "from", "to", "cc", "bcc", "inReplyTo", "references"],
      "properties": {
        "subject": {"type": "string"},
        "raw": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "from": {"$ref": "#/$defs/agents"},
        "to": {"$ref": "#/$defs/agents"},
        "cc": {"$ref": "#/$defs/agents"},
        "bcc": {"$ref": "#/$defs/agents"},
        "inReplyTo": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized", "normalizedFromInvalid"],
      "properties": {
        "normalized": {"type": "string", "format": "date-time"},
        "raw": {"type": "string"},
        "normalizedFromInvalid": {"type": "boolean"},
        "evidence": {"type": "string"}
      },
      "allOf": [{"if": {"properties": {"normalizedFromInvalid": {"const": true}}}, "then": {"required": ["raw", "evidence"]}}]
    },
    "selectedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMediaType", "renderingMediaType", "text", "html", "unsupported"],
      "properties": {
        "sourceMediaType": {"type": "string", "minLength": 1},
        "renderingMediaType": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "html": {"type": "string"},
        "preservedRtf": {"$ref": "#/$defs/payload"},
        "unsupported": {"type": "boolean"}
      }
    },
    "memberships": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "address", "parseStatus"],
        "properties": {
          "name": {"type": "string"},
          "address": {"type": "string"},
          "parseStatus": {"enum": ["parsed", "recovered", "unresolved"]}
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "md5", "sha256"],
      "properties": {
        "byteLength": {"type": "integer", "minimum": 0},
        "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inlineBase64": {"type": "string", "contentEncoding": "base64"},
        "relativePath": {"type": "string", "minLength": 1}
      },
      "oneOf": [{"required": ["inlineBase64"]}, {"required": ["relativePath"]}]
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originalFilename", "originalContentType", "inline", "isEmailAttachment", "originalPayload", "storedPayload", "omitted"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "originalFilename": {"type": "string", "minLength": 1},
        "originalContentType": {"type": "string", "minLength": 1},
        "pdfFilename": {"type": "string", "minLength": 1},
        "contentId": {"type": "string"},
        "inline": {"type": "boolean"},
        "isEmailAttachment": {"type": "boolean"},
        "originalPayload": {"$ref": "#/$defs/payload"},
        "storedPayload": {"$ref": "#/$defs/payload"},
        "omitted": {"type": "boolean"},
        "omissionReason": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"omitted": {"const": true}}}, "then": {"required": ["omissionReason"], "properties": {"storedPayload": {"properties": {"byteLength": {"const": 0}}}}}}]
    }
  }
}
