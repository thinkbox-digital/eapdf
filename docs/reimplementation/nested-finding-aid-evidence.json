  "contracts": {
    "findingAid": "Generated index is an explicitly labelled RFC 822 message rendered as PDF/mail-1s, with its own preserved source and native XLSX attachment. It is not original archived correspondence and is not sent. Reserved sender finding-aid@eapdf.invalid.",
    "collection": "Finding-aid EA-PDF is a root Supplement, never a source-set companion or an exception to rule 218. All EA-PDF children receive recursive validation.",
    "isolation": "ci may include the generated s auxiliary; original archived message children remain si.",
    "settings": "pdfEnabled controls optional finding aids; embedPdfInCollections requests root PDF; embedExcel requests XLSX inside it and implies the PDF; excelEnabled independently requests external XLSX. Container PREMIS stays sidecar-only.",
    "samples": "Four auxiliary examples are exact extracted nested PDF/XLSX copies; six supported primary samples and existing single-message alias regenerated. Legacy social samples have no supported generators and remain historical.",
    "limits": "Generated source/body/PDF consume existing message/body/rendering/output/page limits. No new CLI arguments or relaxed validation rules."
  },
