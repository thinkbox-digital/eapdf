+        message_id=norm_text(att.get("Message-ID",""))
+        filename=att.get("Filename","") if is_xmp_text(att.get("Filename")) else ""
+        checksum=att.get("CheckSum","") if is_xmp_text(att.get("CheckSum")) else ""
