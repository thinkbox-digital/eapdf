+            if not placeholder and checksum and checksum.lower()!=source.get("checksum","").lower():
+                continue
+            if media_type_signature(att.get("Content-Type",""))!=media_type_signature(source.get("content_type","")):
+                continue
+            yield index
+    matched_records={}
+    matched_sources={}
