@@ -0,0 +1,45 @@
+"""Supplied conditional Table 19 identities keep their required XMP type."""
+import hashlib
+import json
+import os
+import unittest
+
+from test_preservation_safety import ROOT, validator as v, failed_codes
+
+
+class AttachmentIdentitySchemaTests(unittest.TestCase):
+    def test_supplied_guid_type_is_checked_independently_of_message_id_presence(self):
+        base = {'Filename': 'file.txt', 'SizeInBytes': '0', 'Content-Type': 'text/plain', 'Message-ID': 'id'}
+        for value in (v.XmpUri('owner'), ['owner'], {'Label': 'owner'}):
+            with self.subTest(value=value):
+                report = v.Report('identity.pdf')
+                v.validate_attachment_records([dict(base, Mail_GUID=value)], [], report)
+                self.assertEqual({'ATTACHMENT_XMP_MAIL_GUID_IF_NO_MESSAGE_ID'}, failed_codes(report))
+        for values in (base, dict(base, Mail_GUID='owner'), dict(base, Mail_GUID='urn:owner')):
+            report = v.Report('identity.pdf')
+            v.validate_attachment_records([values], [], report)
+            self.assertFalse(failed_codes(report))
+
+    def test_identity_representations_in_the_custom_pdf_pipeline(self):
+        directory = ROOT / 'tests/fixtures/eapdf/validator-attachment-identity'
+        for case in json.loads((directory / 'expectations.json').read_text())['cases']:
+            with self.subTest(file=case['file']):
+                report = v.validate(str(directory / case['file']))
+                self.assertEqual(set(case['expected_failures']), failed_codes(report))
+                self.assertEqual(case['expected_status'], report.summary()['status'])
+
+    @unittest.skipUnless(os.environ.get('EAPDF_GENERATOR_CLASSPATH'), 'Set EAPDF_GENERATOR_CLASSPATH for independent PDF/A checks')
+    def test_frozen_identity_corpus(self):
+        directory = ROOT / 'tests/fixtures/eapdf/validator-attachment-identity'
+        for case in json.loads((directory / 'expectations.json').read_text())['cases']:
+            path = directory / case['file']
+            with self.subTest(file=case['file']):
+                self.assertEqual(case['sha256'], hashlib.sha256(path.read_bytes()).hexdigest())
+                result = v.validate_one(str(path), write_html=False)
+                self.assertEqual('PASS', result['pdfa']['status'])
+                self.assertEqual(case['expected_status'], result['summary']['status'])
+                self.assertEqual(set(case['expected_failures']), {r['code'] for r in result['items'] if r['level'] == 'FAIL'})
+
+
+if __name__ == '__main__':
+    unittest.main()
--- v14/scripts/build_eapdf_attachment_identity_fixtures.py
+++ v15/scripts/build_eapdf_attachment_identity_fixtures.py
@@ -0,0 +1,70 @@
+"""Table 19 supplied Mail_GUID retains its text type when Message-ID is present."""
+from pathlib import Path
+import hashlib
+import json
+import sys
+from xml.etree import ElementTree as ET
+
+import pikepdf
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+import validate_eapdf as v
+
+
+def main():
+    output = ROOT / 'tests/fixtures/eapdf/validator-attachment-identity'
+    output.mkdir(exist_ok=True)
+    source = ROOT / 'tests/fixtures/eapdf/validator-attachment-streams/valid.pdf'
+    cases = []
+    for form in ('normal', 'absent', 'qualified', 'attribute', 'uri', 'array', 'structure', 'foreign-extension'):
+        with pikepdf.open(source) as pdf:
+            root, namespaces, _ = v.parse_xmp(v.read_metadata_stream(pdf), v.Report('parse'))
+            for prefix, uri in namespaces.items():
+                ET.register_namespace(prefix, uri)
+            record = root.find('.//' + v.qn(v.NS_PDFMAILMETA, 'attachments') + '/' + v.qn(v.NS_RDF, 'Bag'))[0]
+            guid = record.find(v.qn(v.NS_PDFMAILMETA, 'Mail_GUID'))
+            identity = guid.text
+            message = v.flatten_email_records(root)[0]['messageid']
+            ET.SubElement(record, v.qn(v.NS_PDFMAILMETA, 'Message-ID')).text = message
+            guid.text = None
+            if form == 'normal':
+                guid.text = identity
+            elif form == 'absent':
+                record.remove(guid)
+            elif form == 'qualified':
+                guid.set(v.qn(v.NS_RDF, 'parseType'), 'Resource')
+                ET.SubElement(guid, v.qn(v.NS_RDF, 'value')).text = identity
+                ET.SubElement(guid, v.qn(v.NS_XMP, 'Label')).text = 'Qualified identity'
+            elif form == 'attribute':
+                record.remove(guid)
+                record.set(v.qn(v.NS_PDFMAILMETA, 'Mail_GUID'), identity)
+            elif form == 'uri':
+                guid.set(v.qn(v.NS_RDF, 'resource'), identity)
+            elif form == 'array':
+                ET.SubElement(ET.SubElement(guid, v.qn(v.NS_RDF, 'Bag')), v.qn(v.NS_RDF, 'li')).text = identity
+            elif form == 'structure':
+                guid.set(v.qn(v.NS_RDF, 'parseType'), 'Resource')
+                ET.SubElement(guid, v.qn(v.NS_XMP, 'Label')).text = identity
+            elif form == 'foreign-extension':
+                record.remove(guid)
+                ET.SubElement(record, '{https://example.org/vendor/}Mail_GUID', {v.qn(v.NS_RDF, 'resource'): identity})
+            packet = ET.tostring(root, encoding='utf-8')
+            for prefix, uri in (('pdfmail', v.NS_PDFMAIL), ('pdfmailid', v.NS_PDFMAILID), ('pdfmailmeta', v.NS_PDFMAILMETA)):
+                if ('xmlns:' + prefix + '=').encode() not in packet:
+                    root.set('xmlns:' + prefix, uri)
+            pdf.Root.Metadata.write(ET.tostring(root, encoding='utf-8'))
+            path = output / (form + '.pdf')
+            pdf.save(path, fix_metadata_version=False)
+        failures = ['ATTACHMENT_XMP_MAIL_GUID_IF_NO_MESSAGE_ID'] if form in ('uri', 'array', 'structure') else []
+        cases.append({'file': path.name, 'sha256': hashlib.sha256(path.read_bytes()).hexdigest(),
+                      'expected_failures': failures, 'expected_status': 'FAIL' if failures else 'PASS',
+                      'required_unavailable_codes': []})
+    (output / 'expectations.json').write_text(json.dumps({'authority': 'EA-PDF 9.8.4 Table 19: Mail_GUID text string, conditional presence; supplied fields retain declared types.',
+        'source': str(source.relative_to(ROOT)), 'source_sha256': hashlib.sha256(source.read_bytes()).hexdigest(),
+        'cases': cases}, indent=2)+'\n')
+    print('Wrote', len(cases), 'attachment identity probes')
+
+
+if __name__ == '__main__':
+    main()
