<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>local</groupId><artifactId>eapdf-validator</artifactId><version>2.2.0-beta.3</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <validator.main.class>eapdf.ValidatorGui</validator.main.class>
    <project.build.outputTimestamp>2026-10-31T00:00:00Z</project.build.outputTimestamp>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <eapdf.build.directory>${java.io.tmpdir}/eapdf-validator-build</eapdf.build.directory>
  </properties>
  <repositories>
    <repository><id>vera-dev</id><url>https://artifactory.openpreservation.org/artifactory/vera-dev</url></repository>
  </repositories>
  <dependencyManagement><dependencies>
    <!-- Keep the POI runtime on an API release fixing CVE-2026-49844. -->
    <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.26.1</version></dependency>
    <dependency><groupId>org.verapdf</groupId><artifactId>core</artifactId><version>1.31.56</version></dependency>
    <dependency><groupId>org.verapdf</groupId><artifactId>pdf-model</artifactId><version>1.31.14</version></dependency>
    <dependency><groupId>org.verapdf</groupId><artifactId>parser</artifactId><version>1.31.71</version></dependency>
    <dependency><groupId>org.verapdf</groupId><artifactId>verapdf-xmp-core</artifactId><version>1.31.56</version></dependency>
  </dependencies></dependencyManagement>
  <dependencies>
    <dependency><groupId>com.beetstra.jutf7</groupId><artifactId>jutf7</artifactId><version>1.0.0</version></dependency>
    <dependency><groupId>org.apache.poi</groupId><artifactId>poi</artifactId><version>6.0.0</version></dependency>
    <dependency><groupId>org.verapdf</groupId><artifactId>validation-model</artifactId><version>1.31.221</version>
      <exclusions><exclusion><groupId>com.sun.xml.bind</groupId><artifactId>jaxb-core</artifactId></exclusion></exclusions>
    </dependency>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version></dependency>
    <dependency><groupId>com.sun.istack</groupId><artifactId>istack-commons-runtime</artifactId><version>3.0.5</version></dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.15.0</version></dependency>
    <dependency><groupId>jakarta.mail</groupId><artifactId>jakarta.mail-api</artifactId><version>2.1.5</version></dependency>
    <dependency><groupId>org.eclipse.angus</groupId><artifactId>angus-mail</artifactId><version>2.0.5</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${eapdf.build.directory}</directory><finalName>eapdf-validator-${project.version}</finalName>
    <resources>
      <resource>
        <directory>${project.basedir}/..</directory><targetPath>validator</targetPath><filtering>false</filtering>
        <includes><include>validator_rule_text.json</include><include>config/verapdf/ISO-32005.xml</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/..</directory><targetPath>META-INF/eapdf</targetPath><filtering>false</filtering>
        <includes><include>LICENSE</include><include>NOTICE</include></includes>
      </resource>
      <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
      <resource><directory>${project.basedir}/../third_party_licenses</directory><targetPath>META-INF/eapdf/third-party</targetPath><filtering>false</filtering>
        <includes><include>jutf7-MIT.txt</include></includes>
      </resource>
      <resource><directory>src/main/java</directory><targetPath>META-INF/eapdf/modified-verapdf-sources</targetPath><filtering>false</filtering>
        <includes><include>org/verapdf/pdfa/validation/validators/BaseValidator.java</include><include>org/verapdf/pdfa/validation/validators/SpillableIdSet.java</include><include>org/verapdf/parser/XrefStreamParser.java</include><include>org/verapdf/pd/structure/StructureElementAccessObject.java</include><include>org/verapdf/gf/model/impl/pd/GFPDContentStream.java</include><include>org/verapdf/as/filters/ASInFilter.java</include><include>org/verapdf/cos/COSDictionary.java</include></includes>
      </resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/eapdf</targetPath><filtering>false</filtering>
        <includes><include>README.md</include><include>THIRD_PARTY_NOTICES.md</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version>
        <configuration><useModulePath>false</useModulePath></configuration>
        <executions><execution><id>verify-executable-jar</id><phase>verify</phase><goals><goal>test</goal></goals>
          <configuration>
            <includes><include>**/ExecutableJarPackagingIT.java</include></includes>
            <systemPropertyVariables>
              <validator.packagedJar>${project.build.directory}/${project.build.finalName}.jar</validator.packagedJar>
              <validator.mainClass>${validator.main.class}</validator.mainClass>
            </systemPropertyVariables>
          </configuration>
        </execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><forceCreation>true</forceCreation>
          <archive><manifest><mainClass>${validator.main.class}</mainClass></manifest></archive>
        </configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.2</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <shadedArtifactAttached>false</shadedArtifactAttached>
            <minimizeJar>false</minimizeJar>
            <filters><filter><artifact>org.verapdf:core</artifact><excludes>
              <exclude>org/verapdf/pdfa/validation/validators/BaseValidator.class</exclude>
              <exclude>org/verapdf/pdfa/validation/validators/BaseValidator$ObjectWithContext.class</exclude>
            </excludes></filter><filter><artifact>org.verapdf:validation-model</artifact><excludes><exclude>org/verapdf/gf/model/impl/pd/GFPDContentStream.class</exclude></excludes></filter><filter><artifact>org.verapdf:parser</artifact><excludes><exclude>org/verapdf/pd/structure/StructureElementAccessObject.class</exclude><exclude>org/verapdf/parser/XrefStreamParser.class</exclude><exclude>org/verapdf/as/filters/ASInFilter.class</exclude><exclude>org/verapdf/cos/COSDictionary.class</exclude></excludes></filter><filter><artifact>*:*</artifact><excludes>
              <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude>
              <exclude>module-info.class</exclude><exclude>META-INF/versions/**/module-info.class</exclude>
            </excludes></filter></filters>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/LICENSE</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/LICENSE.txt</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/LICENSE.md</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/NOTICE</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/NOTICE.txt</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/NOTICE.md</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer"><resource>META-INF/DEPENDENCIES</resource></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>${validator.main.class}</mainClass></transformer>
            </transformers>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
